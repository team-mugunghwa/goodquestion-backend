DB_URL=jdbc:postgresql://localhost:5432/goodquestion
DB_USERNAME=
DB_PASSWORD=

# 자체 발급 Access 토큰(JWT) 서명 키 — openssl rand -base64 32 등으로 생성
JWT_SECRET=
# Access 토큰 만료(ms). 미설정 시 30분
JWT_EXPIRATION_MS=1800000
# 리프레시 토큰 만료(ms). 미설정 시 14일
JWT_REFRESH_EXPIRATION_MS=1209600000

# 카카오 로그인 — REST API 키(인가 코드 교환에 필요). 미설정 시 소셜 로그인 401
KAKAO_CLIENT_ID=
# 카카오 콘솔에서 client secret을 '사용함'으로 설정한 경우에만
KAKAO_CLIENT_SECRET=

# 구글 OAuth 2.0 클라이언트 — 인가 코드 교환에 필요
GOOGLE_CLIENT_ID=
# 현재 웹 서버 OAuth 흐름에서는 필수. 프론트엔드나 Git에 포함하지 않는다.
GOOGLE_CLIENT_SECRET=

# 비밀번호 재설정 메일 발송. 로컬에서는 Mailpit(기본 1025)을 사용할 수 있습니다.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@goodquestion.local
FRONTEND_BASE_URL=http://localhost:7357

# DB 컬럼 도입 전 개발용 메모리 저장 정책입니다. 서버 재시작 시 초기화됩니다.
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCK_DURATION=24h
PASSWORD_RESET_TOKEN_TTL=30m
