DB_URL=jdbc:postgresql://localhost:5432/goodquestion
DB_USERNAME=
DB_PASSWORD=

# 자체 발급 Access 토큰(JWT) 서명 키 — openssl rand -base64 32 등으로 생성
JWT_SECRET=
# Access 토큰 만료(ms). 미설정 시 30분
JWT_EXPIRATION_MS=1800000
# 리프레시 토큰 만료(ms). 미설정 시 14일
JWT_REFRESH_EXPIRATION_MS=1209600000

# 카카오 로그인 — REST API 키(인가 코드 교환에 필요). 미설정 시 소셜 로그인 401
KAKAO_CLIENT_ID=
# 카카오 콘솔에서 client secret을 '사용함'으로 설정한 경우에만
KAKAO_CLIENT_SECRET=

# 비밀번호 재설정 메일 발송(SMTP). 전부 기본값 없이 필수 — 미설정이면 기동이 막힌다
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
# 발신자 주소
SMTP_FROM=
# 비밀번호 재설정 링크가 가리킬 프론트엔드 주소. 미설정 시 http://localhost:7357
FRONTEND_BASE_URL=

LOKI_URL=
LOKI_USER=
LOKI_TOKEN=
